<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terbility_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textColor="@color/terbility_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROMPT COLOR"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/color_pink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Deep Pink"
            android:textColor="#FF1493"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/color_green"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Retro Green"
            android:textColor="#00FF00"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/color_cyan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Cyber Cyan"
            android:textColor="#00FFFF"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/color_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Alert Orange"
            android:textColor="#FFA500"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/color_purple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Royal Purple"
            android:textColor="#BF40BF"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/terbility_divider"
            android:layout_marginVertical="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME"
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/theme_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Dark Mode (Default)"
            android:textColor="@color/terbility_text"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/theme_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- Light Mode"
            android:textColor="@color/terbility_text"
            android:background="@android:color/transparent"
            android:gravity="start|center_vertical"
            android:padding="12dp"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
